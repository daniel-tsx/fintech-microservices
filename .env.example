NODE_ENV=development
LOG_LEVEL=info
KAFKA_BROKERS=redpanda:9092
DATABASE_ADMIN_URL=postgres://ledgerflow:ledgerflow@postgres:5432/postgres
PAYMENT_DATABASE_URL=postgres://ledgerflow:ledgerflow@postgres:5432/payments
WALLET_DATABASE_URL=postgres://ledgerflow:ledgerflow@postgres:5432/wallets
LEDGER_DATABASE_URL=postgres://ledgerflow:ledgerflow@postgres:5432/ledger
PSP_DATABASE_URL=postgres://ledgerflow:ledgerflow@postgres:5432/psp
RECONCILIATION_DATABASE_URL=postgres://ledgerflow:ledgerflow@postgres:5432/reconciliation
PSP_WEBHOOK_SECRET=replace-for-local-development
PSP_STATEMENT_SECRET=replace-with-an-independent-local-statement-secret
RECONCILIATION_OPERATOR_TOKEN=replace-with-a-long-local-operator-token
PAYMENT_WEBHOOK_URL=http://localhost:3002/v1/webhooks/psp
ALLOW_PSP_TEST_SCENARIOS=false
PAYMENT_RECOVERY_AGE_MS=2000
JWT_PUBLIC_KEY=replace-with-a-development-public-key
