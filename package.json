{
  "name": "ledgerflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node node_modules/typescript/lib/tsc.js -p tsconfig.build.json",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "demo:happy-payment": "tsx scripts/demo.ts happy-payment",
    "demo:payment-timeout": "tsx scripts/demo.ts payment-timeout",
    "demo:duplicate-webhook": "tsx scripts/demo.ts duplicate-webhook",
    "demo:transfer-concurrency": "tsx scripts/demo.ts transfer-concurrency",
    "demo:reconciliation-mismatch": "tsx scripts/demo.ts reconciliation-mismatch",
    "demo:refund": "tsx scripts/demo.ts refund",
    "demo:durable-payment": "tsx scripts/durable-payment.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.44.5",
    "helmet": "^8.1.0",
    "kafkajs": "^2.2.4",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
